# Copy to .env and fill in. Order Desk reads .env from the folder it runs in, or the files given with
# -keys (orderdesk -keys .env,whatsapp.env). Never commit .env: it is git-ignored.
#
# What works without any key: the panel, the ERP connection and sync, typed orders resolved by codes,
# aliases and rules, questions, and booking in the ERP. Without META_MODEL_API_KEY the AI steps (voice,
# photos, invoices, the Muse Spark pick and the rule engineer) are skipped and those lines are asked.

# Needed for the AI steps: a Meta Model API key from https://dev.meta.ai (Muse Spark, Muse Wonder, Muse Voice Transcribe, SAM 3.1).
META_MODEL_API_KEY=

# Chat channels: set at least one. Without any, orders can still be tried from the panel.
# Telegram: a bot token from @BotFather (long polling, no public address needed).
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (webhook at /whatsapp/webhook, needs a public HTTPS address). See docs/WHATSAPP.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_APP_SECRET is required: Order Desk refuses to start the WhatsApp channel without it (it checks
# that every webhook call comes from Meta), except against a local simulator (tools/whatsapp-sim).
# WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0

# Or WhatsApp through Twilio (used instead of the Cloud API when all three are set).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# TWILIO_WEBHOOK_URL=https://your-public-address/whatsapp/webhook

# Voice notes need ffmpeg; set its path if it is not on the PATH.
# FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe

# The ERP is connected from the panel (Settings → ERP connection), not here.
#
# The variables below are only for the live tests, and `go test` does not read .env: set them in the
# shell that runs the tests (see docs/ERPS.md). Without them those tests are skipped.
# ODOO_URL=http://127.0.0.1:8069
# ODOO_DB=orderdesk
# ODOO_LOGIN=admin
# ODOO_KEY=
# ERPNEXT_URL=http://127.0.0.1:8090
# ERPNEXT_USER=Administrator
# ERPNEXT_PASS=admin
# DOLIBARR_URL=http://127.0.0.1:8081
# DOLIBARR_KEY=                       # printed by erps/seed/dolibarr_setup.py
# DOLIBARR_USER=admin
# DOLIBARR_PASS=admin
# INVENTREE_URL=http://127.0.0.1:8083
# INVENTREE_USER=admin
# INVENTREE_PASS=admin
# TRYTON_URL=http://127.0.0.1:8000
# TRYTON_DB=orderdesk
# TRYTON_USER=admin
# TRYTON_PASS=admin
# ORDERDESK_PHOTO=shelf.jpg          # live photo test: go test ./internal/desk -run Live
# ORDERDESK_PHOTO_OUT=marked.jpg      # where that test writes the photo with its boxes

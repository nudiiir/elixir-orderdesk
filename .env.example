# Copy to .env and fill in. Order Desk reads .env from the folder it runs in (or the files given with -keys).
# Never commit .env.

# Required: a Meta Model API key from https://dev.meta.ai (Muse Spark, Muse Wonder, Muse Voice Transcribe, SAM 3.1).
META_MODEL_API_KEY=

# Chat channels: set at least one. Without any, orders can still be tried from the panel.
# Telegram: a bot token from @BotFather (long polling, no public address needed).
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (webhook at /whatsapp/webhook, needs a public HTTPS address). See docs/WHATSAPP.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0

# Or WhatsApp through Twilio (used instead of the Cloud API when all three are set).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# TWILIO_WEBHOOK_URL=https://your-public-address/twilio/webhook

# Voice notes need ffmpeg; set its path if it is not on the PATH.
# FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe

# The ERP is connected from the panel (Settings → ERP), not here. The variables below are only for the
# live adapter tests (go test ./internal/adapter/...) against the Docker ERPs in erps/.
# ODOO_URL=http://127.0.0.1:8069
# ODOO_DB=orderdesk
# ODOO_LOGIN=admin
# ODOO_KEY=
# ERPNEXT_URL=http://127.0.0.1:8090
# ERPNEXT_USER=Administrator
# ERPNEXT_PASS=admin
# DOLIBARR_URL=http://127.0.0.1:8081
# DOLIBARR_USER=admin
# DOLIBARR_PASS=admin
# INVENTREE_URL=http://127.0.0.1:8083
# INVENTREE_USER=admin
# INVENTREE_PASS=admin
# TRYTON_URL=http://127.0.0.1:8000
# TRYTON_DB=orderdesk
# TRYTON_USER=admin
# TRYTON_PASS=admin
